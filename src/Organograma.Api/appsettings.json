{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/funcionarios",
    "DatabaseName": "funcionarios"
  },
  "Jwt": {
    "Secret": "dev_jwt_secret_change_me",
    "ExpiresIn": "24h"
  },
  "Redis": {
    "Url": "redis://localhost:6379"
  },
  "Aws": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Region": "us-east-2",
    "BucketName": "system-organograma"
  },
  "Cors": {
    "BaseDomain": "",
    "Origins": "http://master.localhost:5173,http://demo.localhost:5173"
  },
  "BrandingPolicy": {
    "CustomCssEnabled": true,
    "CustomCssMaxLength": 20000,
    "EditableFields": "logoUrl,faviconUrl,displayName,primaryColor,secondaryColor,primaryContrast,headerBg,headerText,sidebarBg,sidebarText,surfaceBg,pageBg,textColor,mutedColor,borderColor,fontFamily,fontUrl,themeMode,customCss",
    "AllowedSelectors": ".login-page,.login-card,.sidebar,.app-header,.app-shell,.btn-brand,.dashboard-page,.dashboard-stat,.relatorio-preview,.relatorio-document",
    "FontUrlHosts": "fonts.googleapis.com,fonts.gstatic.com",
    "BrandingAssetMaxBytes": 2097152
  },
  "App": {
    "NodeEnv": "development",
    "Port": 3000,
    "RateLimitMax": 100
  }
}
