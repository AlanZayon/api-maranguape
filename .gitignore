## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# .NET
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets
*.DotSettings.user

# Test / coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage/
*.coverage
*.coveragexml
TestResults/

# Node leftovers (should not reappear)
node_modules/
dist/
npm-debug.log*

# IDE / OS
.vscode/
.idea/
.DS_Store
*.tmp
*.swp
*.bak
*.log

# Secrets
.env
.env.render
.env.vercel
*.pfx
*.pem

# Misc
gerar-dados.js
