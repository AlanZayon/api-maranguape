# Database
MONGO_CONNECTING_FUNCIONARIOS=mongodb://localhost:27017/funcionarios
# Atlas Search indexes (autocomplete_funcionarios, autocomplete_setores, busca_geral_funcionarios).
# Leave false until those indexes exist — regex fallback is used by default.
ATLAS_SEARCH_ENABLED=false

# Authentication
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRES_IN=24h

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=

# Redis
REDIS_URL=redis://localhost:6379

# Hangfire (embedded in API process by default)
DISABLE_HANGFIRE=false

# Server
PORT=3000
ASPNETCORE_ENVIRONMENT=Development

# Multi-tenant
# Local: leave empty (CORS allows *.localhost)
# Production: BASE_DOMAIN=yourdomain.com
BASE_DOMAIN=
# Extra origins CSV
CORS_ORIGINS=http://master.localhost:5173,http://demo.localhost:5173

# Rate limit (requests per minute per IP)
RATE_LIMIT_MAX=100

# Branding / custom CSS policy (front reads via GET /api/tenants/branding-policy)
TENANT_CUSTOM_CSS_ENABLED=true
TENANT_CUSTOM_CSS_MAX_LENGTH=20000
TENANT_BRANDING_EDITABLE_FIELDS=logoUrl,faviconUrl,displayName,primaryColor,secondaryColor,primaryContrast,headerBg,headerText,sidebarBg,sidebarText,surfaceBg,pageBg,textColor,mutedColor,borderColor,fontFamily,fontUrl,themeMode,customCss
TENANT_CUSTOM_CSS_ALLOWED_SELECTORS=.login-page,.login-card,.sidebar,.app-header,.app-shell,.btn-brand,.dashboard-page,.dashboard-stat,.relatorio-preview,.relatorio-document
TENANT_FONT_URL_HOSTS=fonts.googleapis.com,fonts.gstatic.com
TENANT_BRANDING_ASSET_MAX_BYTES=2097152

# Seed superadmin (optional CLI / startup tooling)
SUPERADMIN_ID=superadmin
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_me

# Seed demo tenant (tools/SeedDemo)
DEMO_TENANT_SLUG=demo
DEMO_TENANT_NAME=Prefeitura Demo
DEMO_PASSWORD=Demo@2026
# SEED_DEMO_RESET=true
